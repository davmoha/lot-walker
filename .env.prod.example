# ─────────────────────────────────────────────────────────────────────────────
# Lot Walker — Production Environment Variables
# Copy this file to .env.prod and fill in all values before deploying.
# NEVER commit .env.prod to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=lotwalkr
POSTGRES_USER=lotwalkr
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=8h

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Use SendGrid, Mailgun, Postmark, or any SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
EMAIL_FROM=noreply@yourdomain.com

# ── Deepgram (Voice-to-Action) ────────────────────────────────────────────────
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://yourdomain.com

# ── PostgreSQL Backups (S3) ───────────────────────────────────────────────────
BACKUP_S3_BUCKET=your-backup-bucket-name
BACKUP_S3_REGION=us-east-1
BACKUP_AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
BACKUP_AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# ── Super Admin (created on first boot) ──────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_SUPER_ADMIN_PASSWORD
