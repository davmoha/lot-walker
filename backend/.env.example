# ─────────────────────────────────────────────────────────────────────────────
# Lot Walker — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Option A: full connection string (recommended)
DATABASE_URL=postgresql://lotwalker_admin:your_secure_db_password@localhost:5432/lotwalker

# Option B: individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lotwalker
DB_USER=lotwalker_admin
DB_PASSWORD=your_secure_db_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=8h

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Works with SendGrid, Mailgun, Postmark, Gmail, or any SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@yourdomain.com

# ── Deepgram (Voice-to-Action — Phase 8) ─────────────────────────────────────
# Get a free API key at https://console.deepgram.com
# Leave blank to disable voice features
DEEPGRAM_API_KEY=

# ── Ollama (AI routing — Phase 8) ────────────────────────────────────────────
# Run locally: docker compose up -d ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
